// ============================================================
// 数据驱动：红外 / 433 学习与发射指令表（HOPE-Remote 协议）
//   红外与 433 统一走 Serial1（PA2/PA3，115200 8N1），
//   由槽号区间区分介质，不再分两个串口：
//     红外槽 000-095（096-099 为保留无效区）→ 本表用 000-021
//     射频槽 100-611                        → 本表用 100-107
//   learn=true  → 组帧 "xxNNN"（学习对码）
//   learn=false → 组帧 "fsNNN"（发射已学习码）
//   NNN 为 3 位十进制槽号，学习与发射共用同一槽号
//   射频回放用 fsNNN 默认参数（8 帧 × 1 簇，帧间隔 5ms、簇间隔 300ms），
//   重复发送由 HOPE-Remote 侧负责，本固件只发一次指令
// ============================================================
struct RmCmd {
  uint32_t snid;
  uint16_t slot;
  bool     learn;
};

