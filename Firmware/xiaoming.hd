// ============================================================
// 数据驱动：红外 / 433 学习与发射指令表
//   port=1 → Serial1（红外），port=2 → Serial2（433）
//   cmd 为 4 字节 ASCII："xx"前缀=学习，"fs"前缀=发射
// ============================================================
struct RmCmd {
  uint32_t snid;
  uint8_t  port;
  const char* cmd;
};

